#!/usr/bin/env bash

#SBATCH -J pituitary-nfpa-train
#SBATCH -p rtx8000
#SBATCH -A qtim
#SBATCH -n 1
#SBATCH --cpus-per-task=3
#SBATCH --gres=gpu:1
#SBATCH -t 72:00:00
#SBATCH --mem 100G
#SBATCH --mail-user cbridge@mgh.harvard.edu
#SBATCH --mail-type ALL
#SBATCH -o /homes/8/cpb28/slurm_log/pituitary-nfpa-%j.out

export LD_LIBRARY_PATH="/usr/pubsw/packages/CUDA/11.8/targets/x86_64-linux/lib/"
export PYENV_VERSION='pituitary-nfpa'
pituitary-nfpa train classifier initial-test
